# Copy this file to deploy/server.env, then fill in your server connection.
# deploy/server.env is ignored by Git and must stay on your computer only.
DEPLOY_HOST="SERVER_IP_OR_HOSTNAME"
DEPLOY_USER="deploy"
DEPLOY_PORT="22"
DEPLOY_SSH_KEY="$HOME/.ssh/suijian_deploy"
DEPLOY_ROOT="/srv/suijian"
DEPLOY_DOMAIN="933647.xyz"

# Keep GitHub as a source-code backup after the server release succeeds.
PUSH_GITHUB_BACKUP="1"

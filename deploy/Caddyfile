# 岁笺生产静态站点。Caddy 自动申请和续期 HTTPS 证书。
933647.xyz, www.933647.xyz {
  encode zstd gzip
  root * /srv/suijian/site

  # PWA、OTA 与 Android 安装包必须始终读取最新清单。
  @mutable path / /index.html /index.htm /sw.js /manifest.webmanifest /app-update.json /native-app-update.json
  header @mutable Cache-Control "no-store, max-age=0"

  # 保留静态文件的正常访问；其他前端路径交给单页应用。
  try_files {path} /index.html
  file_server
}
